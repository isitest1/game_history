[
  {"id":"em-d001","kind":"daily","ageMin":40,"ageMax":64,"yearMin":1890,"yearMax":1929,"when":{"childAge":[20,21],"sex":"female"},"text":"息子が徴兵検査に合格した。村の人たちが祝いに来たが、台所でひとり、鍋の湯が沸くのをぼんやり見ていた。","effects":{"happiness":-1},"weight":1,"check":"未確認"},
  {"id":"em-d002","kind":"daily","ageMin":40,"ageMax":64,"yearMin":1894,"yearMax":1905,"when":{"childAge":[20,30]},"text":"出征する息子を、村はずれまで見送った。旗を振る人たちの後ろで、息子の背中が見えなくなるまで立っていた。","effects":{"happiness":-2},"weight":1,"check":"未確認（日清戦争は1894〜95年、日露戦争は1904〜05年とされる）"},
  {"id":"em-d003","kind":"daily","ageMin":40,"ageMax":64,"yearMin":1904,"yearMax":1905,"when":{"childAge":[20,30]},"text":"戦地の息子から、軍事郵便のはがきが届いた。短い文に「達者でいる」とだけあり、何度も読み返した。","effects":{"happiness":1},"weight":1,"check":"未確認（日露戦争は1904〜05年とされる）"},
  {"id":"em-d004","kind":"daily","ageMin":40,"ageMax":64,"yearMin":1905,"yearMax":1929,"when":{"urban":true},"text":"家に電灯がついた。スイッチをひねるだけで明るくなるので、ランプのほやを磨く仕事がなくなった。","effects":{"happiness":2},"weight":1,"check":"一部確認：東京電燈の配電は1887年から。電灯の数は1892年に1万灯を超えた（現代ビジネス、東京電力の史料館）。家庭や村への広まりの時期は未確認"},
  {"id":"em-d005","kind":"daily","ageMin":45,"ageMax":64,"yearMin":1915,"yearMax":1929,"when":{"urban":false},"text":"村にも電気が通った。最初の晩、家じゅうの者が電灯の下に集まって、互いの顔をしげしげと見た。","effects":{"happiness":2},"weight":1,"check":"一部確認：東京電燈の配電は1887年から。電灯の数は1892年に1万灯を超えた（現代ビジネス、東京電力の史料館）。家庭や村への広まりの時期は未確認"},
  {"id":"em-d006","kind":"daily","ageMin":40,"ageMax":64,"yearMin":1900,"yearMax":1929,"when":{"urban":true},"text":"町の活動写真館に、息子に連れられて行った。白い幕の上で人が動き出し、思わず腰を浮かせた。","effects":{"happiness":2},"weight":1,"check":"未確認（活動写真の輸入・公開は1896〜97年とされる）"},
  {"id":"em-d007","kind":"daily","ageMin":40,"ageMax":64,"yearMin":1912,"yearMax":1912,"text":"明治の天皇さまが亡くなったと聞いた。町じゅうの店が戸を閉め、通りが静まり返っていた。","effects":{"happiness":-1},"weight":1,"check":"未確認（明治天皇の崩御は1912年7月とされる）"},
  {"id":"em-d008","kind":"daily","ageMin":40,"ageMax":64,"yearMin":1912,"yearMax":1913,"text":"元号が大正に変わった。生まれたときは江戸の世だったのに、これで三つめの元号を生きることになった。","effects":{},"weight":1,"check":"未確認（大正への改元は1912年7月30日とされる）"},
  {"id":"em-d009","kind":"daily","ageMin":40,"ageMax":64,"yearMin":1918,"yearMax":1918,"text":"米の値が急に上がり、町では米屋に人が押しかけたという話が伝わってきた。家でも麦を多めに混ぜて炊くことにした。","effects":{"happiness":-1},"weight":1,"check":"未確認（米騒動は1918年夏とされる）"},
  {"id":"em-d010","kind":"daily","ageMin":40,"ageMax":64,"yearMin":1918,"yearMax":1920,"text":"ひどい風邪がはやり、村では寝込む人が多かった。家の者に口を手ぬぐいで覆わせ、人の集まるところには行かないようにした。","effects":{"happiness":-1},"weight":1,"check":"未確認（スペインかぜの流行は1918〜20年とされる）"},
  {"id":"em-d011","kind":"daily","ageMin":40,"ageMax":64,"yearMin":1890,"yearMax":1929,"when":{"childAge":[16,25],"urban":false},"text":"息子が東京で勤め口を見つけた。汽車に乗る切符を買いに行く背中を見送りながら、もう村には戻らないだろうと思った。","effects":{"happiness":-1},"weight":1,"check":"未確認"},
  {"id":"em-d012","kind":"daily","ageMin":40,"ageMax":64,"yearMin":1890,"yearMax":1929,"when":{"childAge":[16,25],"sex":"female"},"text":"娘が嫁いで、家の中が急に静かになった。台所に立つと、いつも隣にいた娘の場所が空いていた。","effects":{"happiness":-1},"weight":1,"check":"未確認"},
  {"id":"em-d013","kind":"daily","ageMin":45,"ageMax":64,"yearMin":1914,"yearMax":1929,"text":"初めてキャラメルというものを孫からもらった。口の中で溶けるまで、なかなか飲み込めなかった。","effects":{"happiness":1},"weight":1,"check":"未確認（森永ミルクキャラメルの発売は1914年とされる）"},
  {"id":"em-d014","kind":"daily","ageMin":40,"ageMax":64,"yearMin":1890,"yearMax":1929,"when":{"job":["farm"],"hasChildren":true},"text":"畑の仕事を息子夫婦に任せるようになった。自分は朝のうち少し鍬を持ち、昼からは縁側で藁仕事をした。","effects":{},"weight":1,"check":"未確認"},
  {"id":"em-d015","kind":"daily","ageMin":40,"ageMax":64,"yearMin":1910,"yearMax":1929,"when":{"urban":true,"job":["self"]},"text":"帳場で、そろばんの代わりに息子が計算尺という道具を使っていた。何をしているのか分からず、黙って見ていた。","effects":{},"weight":1,"check":"未確認"},
  {"id":"em-d016","kind":"daily","ageMin":40,"ageMax":64,"yearMin":1905,"yearMax":1929,"when":{"rich":true},"text":"蓄音機で浪花節を聞いた。ラッパから聞こえてくる声に合わせ、思わず膝を叩いて調子をとった。","effects":{"happiness":2},"weight":1,"check":"未確認"},
  {"id":"em-d017","kind":"daily","ageMin":45,"ageMax":64,"yearMin":1890,"yearMax":1929,"when":{"sex":"female","mother":false},"text":"鏡を見ると、髪がすっかり白くなっていた。母が亡くなったときと、同じくらいの年になっていた。","effects":{},"weight":1,"check":"未確認"},
  {"id":"em-d018","kind":"daily","ageMin":40,"ageMax":64,"yearMin":1890,"yearMax":1929,"when":{"married":true},"text":"{spouse}と、銀婚の祝いをした。子どもたちが集まり、写真屋を呼んで家の前で写真を撮った。","effects":{"happiness":2},"weight":1,"check":"未確認"},
  {"id":"em-d019","kind":"daily","ageMin":45,"ageMax":64,"yearMin":1915,"yearMax":1919,"when":{"urban":false},"text":"戦争の景気で、町の工場はどこも人手が足りないと聞いた。村の若い者が、次々に町へ出ていった。","effects":{},"weight":1,"check":"未確認（第一次世界大戦中の好景気とされる）"},
  {"id":"em-d020","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1890,"yearMax":1929,"text":"江戸のころの話をすると、孫は昔話を聞くような顔をした。自分にとっては、ついこのあいだのことだった。","effects":{"relation":1},"weight":1,"check":"未確認"},
  {"id":"em-d021","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1890,"yearMax":1929,"when":{"sex":"male"},"text":"若いころ、ちょんまげを結っていたと孫に話した。孫は、頭の上に何かのせていたのかと聞いた。","effects":{"happiness":1},"weight":1,"check":"未確認"},
  {"id":"em-d022","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1890,"yearMax":1929,"when":{"sex":"female"},"text":"娘のころ、お歯黒をつけていたと孫娘に話した。孫娘は顔をしかめて、自分の白い歯を鏡に映した。","effects":{"happiness":1},"weight":1,"check":"未確認"},
  {"id":"em-d023","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1890,"yearMax":1929,"text":"孫に連れられて、初めて汽車に乗った。窓の外を田んぼが飛ぶように過ぎていき、手すりを握る手に汗をかいた。","effects":{"happiness":2},"weight":1,"check":"未確認"},
  {"id":"em-d024","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1903,"yearMax":1929,"when":{"urban":true},"text":"孫が、電車というものに乗せてくれた。線の上を、牛も馬も引かないのに箱が走るのが不思議でならなかった。","effects":{"happiness":2},"weight":1,"check":"未確認（東京の路面電車の開業は1903年とされる）"},
  {"id":"em-d025","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1925,"yearMax":1929,"text":"家にラジオが来た。小さな箱から、遠くの町の人の声が聞こえてきた。耳の遠い自分のために、家の者が音を大きくしてくれた。","effects":{"happiness":2},"weight":1,"check":"確認済み：東京放送局が1925年3月22日に仮放送、7月12日に愛宕山から本放送を始めた（nippon.com、三井住友トラスト不動産「このまちアーカイブス」）"},
  {"id":"em-d026","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1925,"yearMax":1929,"when":{"urban":true},"text":"ラジオから流れる義太夫に、目を閉じて聞き入った。若いころ、芝居小屋で聞いた声を思い出した。","effects":{"happiness":2},"weight":1,"check":"確認済み：東京放送局が1925年3月22日に仮放送、7月12日に愛宕山から本放送を始めた（nippon.com、三井住友トラスト不動産「このまちアーカイブス」）"},
  {"id":"em-d027","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1890,"yearMax":1929,"text":"孫が兵隊にとられた。見送りの日、自分は杖をついて村はずれまで歩いた。孫は振り返って、帽子を振った。","effects":{"happiness":-1},"weight":1,"check":"未確認"},
  {"id":"em-d028","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1890,"yearMax":1929,"when":{"sex":"female"},"text":"孫が書いた葉書が届いた。字が読めないので、嫁に読んでもらった。最後に「おばあさまもお元気で」とあった。","effects":{"happiness":1},"weight":1,"check":"未確認"},
  {"id":"em-d029","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1910,"yearMax":1929,"text":"電灯の明るさに、なかなか慣れなかった。夜、灯を消してもらってから、月明かりで障子が白く浮かぶのを見て、ようやく眠れた。","effects":{},"weight":1,"check":"一部確認：東京電燈の配電は1887年から。電灯の数は1892年に1万灯を超えた（現代ビジネス、東京電力の史料館）。家庭や村への広まりの時期は未確認"},
  {"id":"em-d030","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1890,"yearMax":1929,"text":"隠居部屋の火鉢で、餅を焼いた。焼けるのを待つあいだ、孫たちが一人ずつ部屋をのぞきに来た。","effects":{"relation":1},"weight":1,"check":"未確認"},
  {"id":"em-d031","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1926,"yearMax":1927,"text":"元号がまた変わった。明治、大正、昭和と指を折り、その前に江戸の元号がいくつもあったことを思い出した。","effects":{},"weight":1,"check":"未確認（昭和への改元は1926年12月25日とされる）"},
  {"id":"em-d032","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1890,"yearMax":1929,"text":"曾孫が生まれた。四代そろった家の写真を撮ろうと言われ、いちばん前の真ん中に座らされた。","effects":{"happiness":2},"weight":1,"check":"未確認"},
  {"id":"em-d033","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1890,"yearMax":1929,"text":"新聞を、孫に読んでもらうのが朝の楽しみだった。分からない言葉が出てくると、孫が自分の言葉で言い直してくれた。","effects":{"relation":1},"weight":1,"check":"未確認"},
  {"id":"em-d034","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1890,"yearMax":1929,"when":{"urban":true},"text":"若いころに奉公した店の前を、何十年ぶりかで通った。店の名前は同じでも、店構えはすっかり洋風になっていた。","effects":{},"weight":1,"check":"未確認"},
  {"id":"em-d035","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1890,"yearMax":1929,"text":"物忘れがひどくなり、孫の名前を言いまちがえた。孫は笑って、自分の名前をもう一度教えてくれた。","effects":{},"weight":1,"check":"未確認"},
  {"id":"em-d036","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1890,"yearMax":1929,"text":"足腰が弱り、寺のお参りにも行けなくなった。仏壇の前で手を合わせるのが、日に何度もの楽しみになった。","effects":{"happiness":-1},"weight":1,"check":"未確認"},
  {"id":"em-d037","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1890,"yearMax":1929,"text":"若いころ歩いて何日もかかった伊勢参りの道を、孫は汽車に乗って一日で行って帰ってきた。お土産の餅を、ゆっくり味わった。","effects":{"happiness":1},"weight":1,"check":"未確認"},
  {"id":"em-d038","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1890,"yearMax":1929,"text":"暖かい日、縁側で孫に草鞋の編み方を教えた。孫は「今は誰も履かないよ」と言いながら、最後まで編んだ。","effects":{"relation":1},"weight":1,"check":"未確認"},
  {"id":"em-d039","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1890,"yearMax":1929,"when":{"urban":false,"sex":"male"},"text":"寄合で、昔の村の境目をめぐる話になった。江戸のころの取り決めを覚えているのは、もう自分ひとりだった。","effects":{"knowledge":1},"weight":1,"check":"未確認"},
  {"id":"em-d040","kind":"daily","ageMin":70,"ageMax":100,"yearMin":1890,"yearMax":1929,"text":"数えで米寿の祝いをしてもらった。親類が大勢集まり、知らない顔の子どもたちが、皆自分の血を引いていると聞いて驚いた。","effects":{"happiness":2},"weight":1,"check":"未確認"},
  {"id":"em-d041","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1890,"yearMax":1929,"when":{"sick":true},"text":"かかりつけの医者が、往診に来てくれた。聴診器を胸に当てられ、冷たさに肩をすくめた。","effects":{},"weight":1,"check":"未確認"},
  {"id":"em-d042","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1923,"yearMax":1923,"text":"大きな地震で東京がひどいことになったと聞いた。東京に出ている孫の無事を、毎日仏壇に祈った。","effects":{"happiness":-2},"weight":1,"check":"未確認（関東大震災は1923年9月1日とされる）"},
  {"id":"em-d043","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1890,"yearMax":1915,"when":{"urban":true},"text":"天気のいい日、孫に手を引かれて、町の勧工場をのぞいた。並んだ品物の多さに、何を見ればよいのか分からなかった。","effects":{"happiness":1},"weight":1,"check":"未確認（勧工場は明治20〜30年代に流行したとされる）"},
  {"id":"em-d044","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1925,"yearMax":1929,"when":{"sex":"male"},"text":"男の人が皆、選挙に行けるようになると聞いた。若いころは名主が何でも決めていたと話すと、孫が驚いた顔をした。","effects":{"knowledge":1},"weight":1,"check":"未確認（普通選挙法の成立は1925年とされる）"},
  {"id":"em-d045","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1890,"yearMax":1929,"text":"夜中に目が覚めて、柱時計の音を数えた。昔は寺の鐘で刻を知ったものだと、ひとりで思った。","effects":{},"weight":1,"check":"未確認"},
  {"id":"em-d046","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1920,"yearMax":1929,"when":{"urban":false},"text":"孫の嫁が、洋服を着て里帰りしてきた。最初は誰だか分からず、挨拶されてから慌てて頭を下げた。","effects":{"happiness":1},"weight":1,"check":"未確認"},
  {"id":"em-d047","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1890,"yearMax":1929,"when":{"married":true},"text":"{spouse}と二人、縁側で茶を飲んだ。若いころの話をしていると、互いの覚えていることが少しずつちがっていて、笑った。","effects":{"relation":1},"weight":1,"check":"未確認"},
  {"id":"em-d048","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1890,"yearMax":1929,"when":{"widowed":true},"text":"{spouse}を見送ってから、ひとりで食べる飯が味気なかった。孫が膳を運んできて、そばで箸を取ってくれた。","effects":{"relation":1},"weight":1,"check":"未確認"},
  {"id":"em-d049","kind":"daily","ageMin":40,"ageMax":70,"yearMin":1890,"yearMax":1929,"when":{"region":["hokkaido"]},"text":"北海道の開墾地で、ようやく畑が広がった。若いころに切り株を掘り起こした日のことを、孫に話して聞かせた。","effects":{"happiness":1},"weight":1,"check":"未確認"},
  {"id":"em-d050","kind":"daily","ageMin":65,"ageMax":100,"yearMin":1890,"yearMax":1929,"when":{"region":["hokkaido"]},"text":"北海道に渡って四十年がたった。内地の故郷の言葉を、もう半分ほど忘れていた。","effects":{},"weight":1,"check":"未確認"},
  {"id":"em-d051","kind":"daily","ageMin":45,"ageMax":80,"yearMin":1890,"yearMax":1929,"when":{"snow":true},"text":"冬のあいだ、雪の重みで家がきしむ音を聞きながら過ごした。若いころは自分で屋根に上ったが、今は孫が上ってくれた。","effects":{"relation":1},"weight":1,"check":"未確認"},
  {"id":"em-d052","kind":"daily","ageMin":45,"ageMax":80,"yearMin":1890,"yearMax":1929,"when":{"region":["tohoku"],"urban":false},"text":"東北の村で、冷たい夏がまた来た。若いころにも同じような年があったと、年寄りたちは空を見上げた。","effects":{"happiness":-1},"weight":1,"check":"未確認"},
  {"id":"em-d053","kind":"daily","ageMin":40,"ageMax":70,"yearMin":1890,"yearMax":1923,"when":{"prefs":[13]},"text":"東京の町に、ずいぶん高い建物が並ぶようになった。浅草の塔に上ると、町じゅうが手のひらに乗るように見えた。","effects":{"happiness":2},"weight":1,"check":"未確認（凌雲閣は1890年開業、1923年の震災で損壊とされる）"},
  {"id":"em-d054","kind":"daily","ageMin":45,"ageMax":80,"yearMin":1914,"yearMax":1929,"when":{"prefs":[13,11,12,14]},"text":"赤い煉瓦の東京駅ができたと聞いて、見物に行った。あまりに大きくて、首が痛くなるまで見上げた。","effects":{"happiness":1},"weight":1,"check":"未確認（東京駅の開業は1914年とされる）"},
  {"id":"em-d055","kind":"daily","ageMin":45,"ageMax":80,"yearMin":1903,"yearMax":1929,"when":{"prefs":[27]},"text":"大阪の町に、市電が走るようになった。昔は堀の舟で行き来した道を、今は電車が走っていた。","effects":{"knowledge":1},"weight":1,"check":"未確認（大阪市電の開業は1903年とされる）"},
  {"id":"em-d056","kind":"daily","ageMin":45,"ageMax":80,"yearMin":1895,"yearMax":1929,"when":{"prefs":[26]},"text":"京都の町に電車が通った。若いころに歩いた三条の通りを、電車が鈴を鳴らして進んでいった。","effects":{"knowledge":1},"weight":1,"check":"未確認（京都電気鉄道の開業は1895年とされる）"},
  {"id":"em-d057","kind":"daily","ageMin":45,"ageMax":80,"yearMin":1890,"yearMax":1929,"when":{"region":["kinki","tokai","chugoku"]},"text":"紡績工場に勤める孫娘が、正月に帰ってきた。工場の話を聞いて、自分が機を織っていたころとのちがいに驚いた。","effects":{"knowledge":1},"weight":1,"check":"未確認"},
  {"id":"em-d058","kind":"daily","ageMin":45,"ageMax":80,"yearMin":1895,"yearMax":1929,"when":{"prefs":[20,19]},"text":"信州の村で、製糸工場へ働きに出た孫娘を見送った。峠を越えていく娘たちの列を、見えなくなるまでながめた。","effects":{"happiness":-1},"weight":1,"check":"未確認"},
