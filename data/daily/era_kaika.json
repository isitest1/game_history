  {"id":"kk-d045","kind":"daily","ageMin":20,"ageMax":45,"yearMin":1872,"yearMax":1889,"when":{"childAge":[6,11]},"text":"{child}が学校から帰ってきて、教わった新しい歌を歌って聞かせた。自分の知らない歌だった。","effects":{"relation":1},"weight":1,"check":"未確認"},
