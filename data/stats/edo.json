の抜粋（藤岡屋日記）。倍率は目安"},{"year":1862,"endYear":1862,"ageMin":0,"ageMax":105,"mult":1.08,"cause":"感染症（コレラ）","note":"文久のコレラ。江戸時代の流行で最も多くの犠牲者を出したとされる（全国の数は不明）。","source":"nippon.com（2020年）"},{"year":1879,"endYear":1879,"ageMin":0,"ageMax":105,"mult":1.12,"cause":"感染症（コレラ）","note":"明治12年のコレラ。死者105,786人（内務省衛生局）。平年の死亡（推計 約88万人）に対する割合から倍率を出した","source":"厚生労働省『平成26年版厚生労働白書』図表1-1-1（内務省衛生局「衛生局年報」）"},{"year":1882,"endYear":1882,"ageMin":0,"ageMax":105,"mult":1.04,"cause":"感染症（コレラ）","note":"明治15年のコレラ。死者33,784人（内務省衛生局）。平年の死亡（推計 約88万人）に対する割合から倍率を出した","source":"厚生労働省『平成26年版厚生労働白書』図表1-1-1（内務省衛生局「衛生局年報」）"},{"year":1886,"endYear":1886,"ageMin":0,"ageMax":105,"mult":1.12,"cause":"感染症（コレラ）","note":"明治19年のコレラ。死者108,405人（内務省衛生局）。平年の死亡（推計 約88万人）に対する割合から倍率を出した","source":"厚生労働省『平成26年版厚生労働白書』図表1-1-1（内務省衛生局「衛生局年報」）"}],"births":{"1800":930000,"1830":957000,"1860":1068000,"1872":1145000,"1880":1210000,"1889":1306500},"infantMortality":{"1800":200.0,"1830":200.0,"1860":185.0,"1889":141.5},"lifeExpectancy":{"1800":{"male":34.0,"female":34.0},"1830":{"male":34.5,"female":34.5},"1860":{"male":36.0,"female":36.5},"1889":{"male":42.55,"female":44.18}},"education":{"elementaryEnrollment":{"1800":{"male":20.0,"female":4.0},"1830":{"male":28.0,"female":7.0},"1850":{"male":37.0,"female":10.0},"1860":{"male":41.0,"female":12.0},"1868":{"male":43.0,"female":13.0},"1872":{"male":43.0,"female":13.0},"1873":{"male":39.9,"female":15.14},"1874":{"male":46.17,"female":17.22},"1875":{"male":50.49,"female":18.58},"1876":{"male":54.16,"female":21.03},"1877":{"male":55.97,"female":22.48},"1878":{"male":57.59,"female":23.51},"1879":{"male":58.21,"female":22.59},"1880":{"male":58.72,"female":21.91},"1881":{"male":59.95,"female":24.67},"1882":{"male":64.65,"female":30.98},"1883":{"male":67.16,"female":33.64},"1884":{"male":66.95,"female":33.29},"1885":{"male":65.8,"female":32.07},"1886":{"male":61.99,"female":29.01},"1887":{"male":60.31,"female":28.26},"1888":{"male":63.0,"female":30.21},"1889":{"male":64.28,"female":30.45}